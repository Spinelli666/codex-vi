# Copie para .env e ajuste. O .env nunca vai para o git.

# Banco (o docker-compose.yml sobe exatamente este)
DATABASE_URL="postgresql://codex:codex@localhost:5433/codex_vi?schema=public"

# URL pública do site (RSS, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin criado pelo seed (npm run db:seed). Use uma senha forte.
ADMIN_EMAIL="voce@exemplo.com"
ADMIN_SENHA="troque-esta-senha"

# Pasta onde ficam as imagens enviadas pelo admin
UPLOAD_DIR="./uploads"
